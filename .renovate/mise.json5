{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Stop the npm manager from updating mise's native lock sidecars; the mise manager regenerates them via `mise lock`",
      matchManagers: ["npm"],
      matchFileNames: [".config/mise/locks/**"],
      enabled: false,
    },
    {
      // FIXME: Remove once Renovate's mise manager resolves oxfmt correctly
      description: "Resolve oxfmt from npm instead of aqua",
      matchManagers: ["mise"],
      matchDepNames: ["oxfmt"],
      overrideDatasource: "npm",
      overridePackageName: "oxfmt",
    },
  ],
}
